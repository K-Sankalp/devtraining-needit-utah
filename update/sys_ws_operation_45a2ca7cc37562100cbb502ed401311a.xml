        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

    // implement resource here
	var requestUser = request.pathParams.user_name;
	var requestQuery = request.queryParams.ni_query;

	var user = new GlideRecord('sys_user');
	user.get('user_name',requestUser);

	var gr = new GlideAggregate('x_58872_needit_needit');
	gr.addAggregate('COUNT');
	gr.addQuery('u_requested_for',user.sys_id);
	//gr.addEncodedQuery(requestQuery);
	gr.query();

	if (gr.next()) {
		var record = parseInt(gr.getAggregate('COUNT'));
	}

	var body = {};
	body.count = record;
	body.user = { 'User ID' : requestUser,
	'User Name' : user.user_name
	};

	response.setBody(body);

})(request, response);]]></operation_script>
